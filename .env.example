# ==============================================================================
# ALFABETIZA LIBRAS - TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Copie este arquivo para .env e preencha com seus valores locais/reais.
# NUNCA envie o arquivo .env preenchido para o controle de versão (Git).
# ==============================================================================

# --- BANCO DE DADOS (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1
POSTGRES_DB=alfabetizalibras
POSTGRES_PORT=5432

# --- STORAGE S3 (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=alfabetizalibras
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- BACKEND (Spring Boot Java 21) ---
SERVER_PORT=8081
JWT_SECRET=c3VwZXItc2VjcmV0LWp3dC1rZXktZm9yLWFsZmFiZXRpemFsaWJyYXMtYXBwbGljYXRpb24tc2VjdXJpdHk=
JWT_EXPIRATION=86400000

# --- FRONTEND (Flutter Web Nginx) ---
WEB_PORT=3000

# --- TÚNEL CLOUDFLARE (Zero Trust) ---
# Cole aqui o Token gerado no painel da Cloudflare (Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# --- URLs PÚBLICAS (Para compilação Web e APK Mobile) ---
PUBLIC_API_URL=https://api.seudominio.com.br
PUBLIC_APP_URL=https://app.seudominio.com.br
